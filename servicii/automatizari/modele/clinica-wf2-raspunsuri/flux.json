    {
      "id": "wf2-n1",
      "name": "Webhook SMS Reply",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        240,
        400
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "sms-reply",
        "responseMode": "responseNode",
        "options": {}
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "wf2-n2",
      "name": "Parseaza Raspuns",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        460,
        400
      ],
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const payload = $input.first().json.body || {};\nconst bodyText = (payload.body || payload.Body || '').trim().toUpperCase();\nconst from = payload.from || payload.From || '';\nlet intent = 'UNKNOWN';\nif (/\\bCONFIRM/.test(bodyText)) intent = 'CONFIRM';\nelse if (/\\bANUL|CANCEL|NU\\b/.test(bodyText)) intent = 'CANCEL';\nelse if (/\\bSTOP|DEZABON/.test(bodyText)) intent = 'OPT_OUT';\nreturn [{ json: { from, body: bodyText, intent } }];"
      }
    },
    {
      "id": "wf2-n3",
      "name": "Citeste Appointments",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        680,
        400
      ],
      "parameters": {
        "resource": "sheet",
        "operation": "read",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "CONFIG_SHEET_ID",
          "cachedResultName": "Clinica - Baza de Date"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Appointments",
          "cachedResultName": "Appointments"
        },
        "range": "Appointments!A:N",
        "options": {}
      }
    },
    {
      "id": "wf2-n4",
      "name": "Gaseste Programare",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        400
      ],
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const from = $('Parseaza Raspuns').first().json.from;\nconst intent = $('Parseaza Raspuns').first().json.intent;\nconst phone = String(from).replace(/^whatsapp:/, '');\nconst rows = $input.all().map(i => i.json);\nconst now = new Date();\nconst candidates = rows.filter(r => r.phone === phone && ['SCHEDULED', 'CONFIRMED'].includes(r.status));\ncandidates.sort((a, b) => new Date(a.appointment_datetime) - new Date(b.appointment_datetime));\nconst match = candidates.find(r => new Date(r.appointment_datetime) > now) || candidates[0] || null;\nreturn [{\n  json: {\n    intent,\n    from: phone,\n    appointment_id: match ? match.appointment_id : null,\n    name: match ? match.name : '',\n    patient_id: match ? match.patient_id : null\n  }\n}];"
      }
    },
    {
      "id": "wf2-n5",
      "name": "Switch pe intentie",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.4,
      "position": [
        1120,
        400
      ],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "outputKey": "CONFIRM",
              "conditions": {
                "options": {
                  "version": 2,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "s1",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "leftValue": "={{ $json.intent }}",
                    "rightValue": "CONFIRM"
                  }
                ]
              }
            },
            {
              "outputKey": "CANCEL",
              "conditions": {
                "options": {
                  "version": 2,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "s2",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "leftValue": "={{ $json.intent }}",
                    "rightValue": "CANCEL"
                  }
                ]
              }
            },
            {
              "outputKey": "OPT_OUT",
              "conditions": {
                "options": {
                  "version": 2,
                  "leftValue": "",
                  "caseSensitive": true,
                  "typeValidation": "strict"
                },
                "combinator": "and",
                "conditions": [
                  {
                    "id": "s3",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    },
                    "leftValue": "={{ $json.intent }}",
                    "rightValue": "OPT_OUT"
                  }
                ]
              }
            }
          ]
        },
        "options": {
          "fallbackOutput": "extra"
        }
      }
    },
