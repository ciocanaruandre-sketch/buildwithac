      "position": [
        240,
        400
      ],
      "parameters": {
        "httpMethod": "POST",
        "path": "programare-clinica",
        "responseMode": "responseNode",
        "options": {}
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "wf1-n2",
      "name": "Citeste Config",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [
        460,
        200
      ],
      "parameters": {
        "resource": "sheet",
        "operation": "read",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "CONFIG_SHEET_ID",
          "cachedResultName": "Clinica - Baza de Date"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "Config",
          "cachedResultName": "Config"
        },
        "range": "Config!A:B",
        "options": {}
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "wf1-n3",
      "name": "Config Map",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        200
      ],
      "parameters": {
        "language": "javaScript",
        "mode": "runOnceForAllItems",
        "jsCode": "const rows = $input.all().map(i => i.json);\nconst cfg = {};\nfor (const r of rows) {\n  cfg[r.key] = r.value;\n}\nreturn [{ json: cfg }];"
      }
    },
    {
      "id": "wf1-n4",
      "name": "Formatare Date",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        460,
        400
      ],
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "patient_id",
              "type": "string",
              "value": "={{ $json.body.patient_id }}"
            },
            {
              "id": "a2",
              "name": "name",
              "type": "string",
              "value": "={{ $json.body.name }}"
            },
            {
              "id": "a3",
              "name": "phone",
              "type": "string",
              "value": "={{ $json.body.phone }}"
            },
            {
              "id": "a4",
              "name": "email",
              "type": "string",
              "value": "={{ $json.body.email }}"
            },
            {
              "id": "a5",
              "name": "appointment_datetime",
              "type": "string",
              "value": "={{ $json.body.appointment_datetime }}"
            },
            {
              "id": "a6",
              "name": "doctor_name",
              "type": "string",
              "value": "={{ $json.body.doctor_name }}"
            },
            {
              "id": "a7",
              "name": "treatment_type",
              "type": "string",
              "value": "={{ $json.body.treatment_type }}"
            },
            {
              "id": "a8",
              "name": "appointment_id",
              "type": "string",
              "value": "={{ 'AP-' + $now.toFormat('yyyyMMddHHmmss') }}"
            },
            {
              "id": "a9",
              "name": "data_ro",
              "type": "string",
              "value": "={{ DateTime.fromISO($json.body.appointment_datetime).setLocale('ro').toFormat('d MMMM yyyy, HH:mm') }}"
            },
            {
              "id": "a10",
              "name": "ora",
              "type": "string",
              "value": "={{ DateTime.fromISO($json.body.appointment_datetime).toFormat('HH:mm') }}"
            },
            {
              "id": "a11",
              "name": "reminder_48h",
              "type": "string",
              "value": "={{ DateTime.fromISO($json.body.appointment_datetime).minus({ hours: 48 }).toISO() }}"
            },
            {
              "id": "a12",
              "name": "reminder_3h",
              "type": "string",
              "value": "={{ DateTime.fromISO($json.body.appointment_datetime).minus({ hours: 3 }).toISO() }}"
            },
            {
              "id": "a13",
              "name": "review_time",
              "type": "string",
              "value": "={{ DateTime.fromISO($json.body.appointment_datetime).plus({ hours: 2 }).toISO() }}"
            }
          ]
        },
        "options": {}
      }
    },
