    {
      "id": "wf4-n6",
      "name": "Analiza zilei",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const ZONA = 'Europe/Bucharest';\nconst LIMITA = 10;\nconst RAMASE = ['SCHEDULED', 'CONFIRMED'];\nconst FORMATE = ['dd.MM.yyyy HH:mm:ss', 'dd.MM.yyyy HH:mm', 'd.M.yyyy H:mm', 'yyyy-MM-dd HH:mm:ss', 'yyyy-MM-dd HH:mm', 'dd/MM/yyyy HH:mm', 'd/M/yyyy H:mm'];\nfunction citesteData(v) {\n  const s = String(v ?? '').trim();\n  if (!s) return null;\n  let d = DateTime.fromISO(s, { zone: ZONA });\n  if (d.isValid) return d;\n  for (const f of FORMATE) {\n    d = DateTime.fromFormat(s, f, { zone: ZONA });\n    if (d.isValid) return d;\n  }\n  return null;\n}\nfunction telefon(v) {\n  let t = String(v ?? '').replace(/[\\s.()-]/g, '');\n  if (/^07\\d{8}$/.test(t)) t = '+40' + t.slice(1);\n  else if (/^00\\d+$/.test(t)) t = '+' + t.slice(2);\n  return t;\n}\nconst acum = DateTime.now().setZone(ZONA);\nconst azi = acum.toFormat('yyyy-MM-dd');\nconst randuri = $('Citește programările').all().map(i => i.json).filter(r => r.appointment_id);\nconst deAzi = [];\nlet necitite = 0;\nfor (const r of randuri) {\n  const d = citesteData(r.appointment_datetime);\n  if (!d) { necitite += 1; continue; }\n  if (d.toFormat('yyyy-MM-dd') === azi) deAzi.push({ r, d });\n}\nconst stare = x => String(x.r.status ?? '').trim().toUpperCase();\nconst neprezentari = deAzi\n  .filter(x => RAMASE.includes(stare(x)) && x.d < acum)\n  .map(x => ({\n    appointment_id: x.r.appointment_id,\n    patient_id: x.r.patient_id ?? '',\n    phone: telefon(x.r.phone),\n    prenume: String(x.r.name ?? '').trim().split(/\\s+/)[0] || ''\n  }));\nconst jurnal = $('Citește jurnalul mesajelor').all().map(i => i.json).filter(l => l.message_type);\nconst rechemari = jurnal.filter(l => l.message_type === 'RECALL' && citesteData(l.timestamp)?.toFormat('yyyy-MM-dd') === azi).length;\nconst preaMulte = neprezentari.length > LIMITA;\nreturn [{\n  json: {\n    data: acum.toFormat('dd.MM.yyyy'),\n    total: deAzi.length,\n    venit: deAzi.filter(x => stare(x) === 'COMPLETED').length,\n    anulat: deAzi.filter(x => stare(x) === 'CANCELLED').length,\n    neprezentari: neprezentari.length,\n    rechemari,\n    recenzii: deAzi.filter(x => x.r.review_sent === 'sent').length,\n    necitite,\n    prea_multe: preaMulte,\n    de_trimis: preaMulte ? [] : neprezentari\n  }\n}];"
      }
    },
