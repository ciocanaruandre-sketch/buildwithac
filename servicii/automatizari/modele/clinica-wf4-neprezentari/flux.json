        "text": "=📊 Ziua de {{ $json.data }}, {{ $('Setările clinicii').first().json.clinic_name }}\nProgramări azi: {{ $json.total }}\nAu venit: {{ $json.venit }} · Anulate: {{ $json.anulat }} · Neprezentări: {{ $json.neprezentari }}\nRechemări trimise: {{ $json.rechemari }} · Cereri de recenzie: {{ $json.recenzii }}{{ $json.prea_multe ? \"\\n\\n⚠️ Peste 10 neprezentări într-o seară: n-am trimis niciun SMS și n-am schimbat nimic în tabel. Probabil tabelul n-a fost completat azi. Verifică-l.\" : ($json.neprezentari > 0 ? \"\\nSMS de reprogramare: \" + $json.neprezentari : \"\") }}{{ $json.necitite > 0 ? \"\\n\\n⚠️ \" + $json.necitite + \" rânduri din tabel au data scrisă într-un fel pe care automatizarea nu-l înțelege. Spune-i lui Andrei.\" : \"\" }}",
        "additionalFields": {
          "appendAttribution": false
        }
      }
    },
